# Auth (set to true for local dev without IdP)
VITE_AUTH_DISABLED=true
# Optional: dev user email when VITE_AUTH_DISABLED=true
# VITE_DEV_EMAIL=dev@localhost
VITE_OIDC_AUTHORITY=https://login.microsoftonline.com/YOUR_TENANT/v2.0
VITE_OIDC_CLIENT_ID=your-euroid-spa-client-id
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Optional: when backend runs in Docker on 3002, use:
# VITE_PROXY_TARGET=http://localhost:3002
