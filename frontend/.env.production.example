# Production OIDC — copy to .env.production and replace placeholders with real IdP values
# See README production setup guide (Entra ID, Auth0, Keycloak)

VITE_AUTH_DISABLED=false
VITE_OIDC_AUTHORITY=https://login.microsoftonline.com/{tenant-id}/v2.0
VITE_OIDC_CLIENT_ID={client-id}
VITE_OIDC_ROLE_CLAIM=roles
VITE_API_BASE_URL=/api/v1
