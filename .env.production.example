# === EuroID Production Environment ===

# MongoDB (use a replica set in production)
MONGO_URI=mongodb://user:password@mongo-host:27017/euroid?authSource=admin&replicaSet=rs0

# Temporal
TEMPORAL_ADDRESS=temporal-host:7233
TEMPORAL_NAMESPACE=euroid-production

# Secrets (REQUIRED)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Auth
AUTH_DISABLED=false
OIDC_ISSUER=https://login.microsoftonline.com/YOUR_TENANT/v2.0
OIDC_AUDIENCE=your-euroid-client-id

# CORS (comma-separated origins)
CORS_ORIGINS=https://euroid.example.com

# OpenTelemetry
OTEL_SDK_DISABLED=false
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=euroid-backend

# Data Retention
WORKFLOW_RETENTION_DAYS=90
USER_EVENTS_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=365
IDENTITY_SOFT_DELETE_RETENTION_DAYS=30
