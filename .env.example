# Docker Compose environment variables
# Copy to .env and customize for your environment:
#   cp .env.example .env
#
# Generate secure passwords (Linux/macOS):
#   openssl rand -base64 24
# Generate ENCRYPTION_KEY (must be exactly 32 bytes, base64-encoded):
#   openssl rand -base64 32

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=              # REQUIRED — generate with: openssl rand -base64 24

# Temporal namespace (optional, default `default`): auto-setup creates it, temporal-init registers
# the TenantId search attribute in it, and euro-api and euro-worker use it
# TEMPORAL_NAMESPACE=default

# Temporal DB (PostgreSQL)
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=        # REQUIRED — generate with: openssl rand -base64 24

# Application
ENCRYPTION_KEY=              # REQUIRED — generate with: openssl rand -base64 32
AUTH_DISABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost
OTEL_SDK_DISABLED=true

# Access graph (optional): Neo4j runs only with `docker compose --profile graph up -d euro-neo4j`.
# Empty: the API and the worker have no graph and the access explorer answers 503.
# Set (8 characters or more): euro-neo4j starts with it and the API and the worker connect to it.
# NEO4J_PASSWORD=
# NEO4J_HEAP_MAX_SIZE=512m
