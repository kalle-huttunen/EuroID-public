  "scripts": {
    "build": "nest build",
    "clean": "rimraf dist",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch --exec \"ts-node -r tsconfig-paths/register src/main.ts\"",
    "start:debug": "nest start --debug --watch --exec \"ts-node -r tsconfig-paths/register src/main.ts\"",
    "start:prod": "node -r tsconfig-paths/register dist/src/main.js",
    "start:worker": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/worker.ts",
    "start:worker:dev": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/worker.ts",
    "start:worker:watch": "cross-env NODE_ENV=development nodemon --watch src --exec ts-node -r tsconfig-paths/register src/worker.ts",
    "start:worker:prod": "cross-env NODE_ENV=production node dist/worker.js",
    "lint": "eslint src/ --fix",
    "lint:ci": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:cov:safe": "jest --coverage --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migrate:up": "ts-node -r tsconfig-paths/register node_modules/.bin/migrate-mongo up -f migrate-mongo-config.ts",
    "migrate:down": "ts-node -r tsconfig-paths/register node_modules/.bin/migrate-mongo down -f migrate-mongo-config.ts",
    "migrate:create": "migrate-mongo create -f migrate-mongo-config.ts",
    "migrate:status": "ts-node -r tsconfig-paths/register node_modules/.bin/migrate-mongo status -f migrate-mongo-config.ts",
    "migrate:up:dist": "node -r ./scripts/load-compiled-migrations.js node_modules/migrate-mongo/bin/migrate-mongo.js up -f migrate-mongo-config.ts",
    "migrate:status:dist": "node -r ./scripts/load-compiled-migrations.js node_modules/migrate-mongo/bin/migrate-mongo.js status -f migrate-mongo-config.ts",
    "migrate:down:dist": "node -r ./scripts/load-compiled-migrations.js node_modules/migrate-mongo/bin/migrate-mongo.js down -f migrate-mongo-config.ts",
    "seed:demo": "ts-node -r tsconfig-paths/register src/scripts/seed-demo-data.ts"
  },
  "overrides": {
    "lodash": "4.18.1",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.13",
    "@temporalio/testing": "^1.14.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.1",
    "@types/pdfkit": "^0.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
