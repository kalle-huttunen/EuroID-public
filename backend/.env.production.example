# Production OIDC — copy to .env.production and replace placeholders with real IdP values
# OIDC_ISSUER must match IdP issuer (e.g. Entra ID: https://login.microsoftonline.com/{tenant-id}/v2.0)
# OIDC_AUDIENCE must match token audience (Entra ID: client-id or api://{client-id})

AUTH_DISABLED=false
OIDC_ISSUER=https://login.microsoftonline.com/{tenant-id}/v2.0
OIDC_AUDIENCE={client-id}
