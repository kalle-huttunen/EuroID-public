# MongoDB (REQUIRED — no fallback)
MONGO_URI=mongodb://admin:<your-mongo-password>@localhost:27017/euroid?authSource=admin
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5

# Redis (optional). Unset: cache and distributed-transaction locks are in-memory, per process
# (dev, a single API and worker). Set: both use Redis, and startup fails if Redis does not answer.
# REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=euroid:
# Security state on Redis (MFA and emergency-token counters, token revocation cache, SAML codes,
# login rate limit):
# a call Redis does not answer within these fails, and its check denies with 503 (fail closed).
# Connecting, then each command; milliseconds.
SECURITY_STORE_CONNECT_TIMEOUT_MS=1000
SECURITY_STORE_COMMAND_TIMEOUT_MS=500

# Server
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Neo4j (optional): the access graph. With NEO4J_PASSWORD empty there is no graph: the event sync
# skips its writes and the access explorer answers 503. Set it on the API and the worker, then load
# the graph with POST /api/v1/access-explorer/resync (super-admin). Compose: profile graph.
# A process that cannot reach Neo4j tries again on a later graph call, at most once per
# NEO4J_RECONNECT_INTERVAL_MS (default 30000).
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# NEO4J_RECONNECT_INTERVAL_MS=30000

# Elasticsearch (optional — fail-open when unavailable; enables ES-backed analytics v2)
# ELASTICSEARCH_NODE=http://localhost:9200
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_INDEX_PREFIX=euroid
# ELASTICSEARCH_MAX_RETRIES=3
# ELASTICSEARCH_REQUEST_TIMEOUT_MS=30000
# ELASTICSEARCH_BULK_FLUSH_INTERVAL_MS=5000
# ELASTICSEARCH_BULK_FLUSH_SIZE=500

# OPA (optional — when enabled, policy evaluation is delegated to Open Policy Agent)
# OPA_ENABLED=false
# OPA_URL=http://localhost:8181
# OPA_POLICY_PATH=euroid/policy/evaluate
# OPA_REQUEST_TIMEOUT_MS=5000
# OPA_FALLBACK_ON_ERROR=true
# OPA_BUNDLE_SYNC_INTERVAL_MS=30000

# Temporal
TEMPORAL_ADDRESS=localhost:7233
# Namespace of the API's client, the worker and its schedules (default `default`). It needs the
# TenantId search attribute (docs/DEPLOYMENT.md § 4. Temporal).
# TEMPORAL_NAMESPACE=default
# Temporal Web UI (for workflow tracking links). Docker: http://localhost:8080
TEMPORAL_UI_URL=http://localhost:8080

# Throttle (rate limiting)
THROTTLE_SHORT_LIMIT=10
THROTTLE_MEDIUM_LIMIT=100

# Login (POST /api/v1/auth/login): per-client limits counted across instances in the security
# state store; while it fails, login answers 503. Requests per second, then requests per minute.
AUTH_THROTTLE_SHORT_LIMIT=5
AUTH_THROTTLE_MEDIUM_LIMIT=15

# Console admin password reset (modules/auth/password-reset.service.ts). A reset link (by email,
# when SMTP_HOST is set) or a super-admin's code works once, for this many minutes (15 to 60).
# PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Requests and confirmations counted in the security state store (503 while it fails): per client
# IP and per address, within the window in minutes.
# PASSWORD_RESET_MAX_PER_IP=10
# PASSWORD_RESET_MAX_PER_EMAIL=3
# PASSWORD_RESET_WINDOW_MINUTES=15

# PII reveal (POST /api/v1/identity/:id/pii/reveal, audited): stricter per-client limits.
# Requests per second, then requests per minute.
PII_REVEAL_THROTTLE_SHORT_LIMIT=5
PII_REVEAL_THROTTLE_MEDIUM_LIMIT=30

# Connector timeouts (ms)
CONNECTOR_TIMEOUT_MS=15000
CONNECTOR_TIMEOUT_HR_MS=30000
# GET /reconciliation/connector-health: per-connector check timeout, and how long a result is reused
CONNECTOR_HEALTH_TIMEOUT_MS=5000
CONNECTOR_HEALTH_CACHE_TTL_MS=30000
# File outbound connector: the directory its output files must be inside (real path, symlinks
# resolved). Required in production wherever the connector is used; elsewhere the working directory.
# FILE_OUTBOUND_ALLOWED_DIR=/var/lib/euroid/file-outbound
# Offboarding: GitHub invitation pages (100 each) searched for a leaver's email
# GITHUB_INVITATION_MAX_PAGES=50
# Okta offboarding when the connector config sets none: deactivate (default) or delete
# (deactivate, then delete the user)
# OKTA_DEPROVISION_STRATEGY=deactivate
# Time-bound access expiry (hourly entitlementExpiryWorkflow): wait before retrying an expired
# entry whose deprovision failed with a retryable error, doubling per failure up to the max (ms)
# ENTITLEMENT_EXPIRY_RETRY_BASE_MS=3600000
# ENTITLEMENT_EXPIRY_RETRY_MAX_MS=86400000

# HR connectors — security (Batch 5)
# CSV_HR_ALLOWED_DIR — required in production. Directory containing CSV files.
# CSV_HR_MAX_ROWS=100000
# CSV_HR_MAX_FILE_SIZE_MB=50
# JSON_HR_ALLOWED_DIR — for local JSON files (falls back to CSV_HR_ALLOWED_DIR)
# JSON_HR_MAX_ITEMS=100000
# ALLOW_JSON_API_LOCAL_FILES=true — only for dev/demo; enables local file paths in prod

# HR leavers (modules/leavers): defaults for tenants without a stored leaver policy.
# A sync starts at most max(MIN_COUNT, min(MAX_COUNT, MAX_PERCENT of active identities)) offboardings; more pause for approval.
# LEAVER_TERMINATED_STATUSES=terminated,inactive,left
# LEAVER_MISSING_SYNC_THRESHOLD=3
# LEAVER_MASS_MAX_COUNT=10
# LEAVER_MASS_MAX_PERCENT=5
# LEAVER_MASS_MIN_COUNT=2
# LEAVER_DEFAULT_TIMEZONE=UTC
# LEAVER_START_CLAIM_TIMEOUT_MS=600000
# Longest wait for one HR-driven workflow start (leaver offboarding, joiner onboarding, mover
# run); a start that fails or times out is tried again by the source's next sync.
# HR_START_TIMEOUT_MS=10000
# An abandoned claim on an approved HR mover batch item (its process died mid-start).
# HR_START_CLAIM_TIMEOUT_MS=600000
# HR_SYNC_RUN_RETENTION_DAYS=180
# HR movers (modules/mover): defaults for tenants without a stored mover policy.
# A sync starts at most max(MIN_COUNT, min(MAX_COUNT, MAX_PERCENT of active identities)) movers; more pause for approval.
# MOVER_MASS_MAX_COUNT=10
# MOVER_MASS_MAX_PERCENT=5
# MOVER_MASS_MIN_COUNT=2
# HR joiners (modules/joiners): defaults for tenants without a stored joiner policy. Joiners start only
# while the pipeline is DEPLOYED; a sync starts at most max(MIN_COUNT, min(MAX_COUNT, MAX_PERCENT of
# active identities)) onboarding runs; more pause for approval.
# JOINER_MASS_MAX_COUNT=10
# JOINER_MASS_MAX_PERCENT=5
# JOINER_MASS_MIN_COUNT=2

# PAM (Privileged Access Management)
# ADMIN_UPN_PATTERN=adm-{firstName}.{lastName}@{domain}
# PAM_TIER2_REQUIRES_ADMIN_ACCOUNT=true
# Highest numeric suffix a namesake's admin UPN gets (adm-anna.berg2@...).
# ADMIN_UPN_MAX_SUFFIX=20
# How long an activation answer waits for the privileged session to enable the accounts (API).
# PAM_ACTIVATION_WAIT_MS=15000
# Disable-only runs the hourly sweep starts per tenant for admin accounts outside a session (worker).
# PAM_STANDING_STATE_SWEEP_LIMIT=50
# Days an Okta admin account may wait for its owner's activation (PROVISIONED) before the hourly
# sweep raises admin_account.activation_pending, once (worker).
# PAM_ACTIVATION_PENDING_ALERT_DAYS=7

# Performance Tuning (page sizes, batch sizes, cache TTLs)
# CORRELATION_NAME_CANDIDATE_LIMIT=500   # Max candidates for heuristic name correlation (IV-5)
# IDENTITY_PAGE_MAX=500                  # Max page size for GET /identity (F2)
# POLICY_PAGE_SIZE=500
# IMPACT_ANALYSIS_SAMPLE_SIZE=500
# IMPACT_ANALYSIS_PAGE_SIZE=300
# POLICY_SUGGESTIONS_PAGE_SIZE=300
# HR_FETCH_PAGE_SIZE=500
# IDENTITY_PROVISIONING_PAGE_SIZE=500
# ARCHIVAL_BATCH_SIZE=1000
# CREDENTIAL_INVENTORY_REFRESH_LIMIT=500
# RECONCILE_BATCH_PAGE_SIZE=5000
# ORPHAN_GRACE_PERIOD_DAYS=30
# ORPHAN_EXTENDED_GRACE_DAYS=30
# ORPHAN_AUTO_DELETE_AFTER_EXTENDED=false
# Accounts orphan detection never quarantines (break-glass, service accounts): UPNs or mails, comma-separated, * = any text
# ORPHAN_EXCLUDED_ACCOUNTS=breakglass@corp.example,svc-*@corp.example
# SKU_CACHE_TTL_MS=300000
# OUTBOX_POLLER_BATCH_SIZE=100
# How long an outbox event a process claimed may stay unpublished before another poll takes it
# again (the process stopped). Well above one publish; a reclaimed event reaches its handlers again.
# OUTBOX_CLAIM_TIMEOUT_MS=300000

# Event Subscriptions / Webhooks
# WEBHOOK_MAX_SUBSCRIPTIONS_PER_TENANT=10
# WEBHOOK_MAX_RETRY_ATTEMPTS=5
# WEBHOOK_DELIVERY_TIMEOUT_MS=10000
# How long a process holds a delivery it sends; a send not finished by then (the process stopped)
# is sent again by the retry poller and counts as an attempt. Must be longer than the timeout.
# WEBHOOK_DELIVERY_LEASE_MS=60000

# Dead Letter Queue Auto-Retry
# DLQ_RETRY_POLL_INTERVAL_MS=60000
# DLQ_MAX_RETRIES=3
# How long a process holds an entry it retries or replays; a re-run not finished by then (the
# process stopped) is taken again by the automatic retry and counts as a failed retry.
# DLQ_RETRY_LEASE_MS=300000

# App (for SCIM discovery, docs URLs)
APP_BASE_URL=https://your-euroid-domain.com

# Email notifications (optional). SMTP_HOST unset or empty: email is off (one log line at startup),
# in-app notifications are unchanged. Set: approvers of access requests, reviewers of access
# reviews and owners of time-bound access expiring in 7 days / tomorrow get an email, and console
# admins can ask for a password reset link
# (backend/src/modules/notifications/docs/ARCHITECTURE.md). Startup fails on an invalid value.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                     # 465 = implicit TLS
# SMTP_SECURE=                      # true/false; default true on port 465, else false (STARTTLS)
# SMTP_REQUIRE_TLS=true             # refuse to send without STARTTLS; false only for a local relay
# SMTP_USER=                        # set both or neither
# SMTP_PASSWORD=
# SMTP_FROM=EuroID <no-reply@example.com>   # required with SMTP_HOST
# SMTP_TIMEOUT_MS=10000             # connection, greeting, socket and DNS timeout, each
# Web app origin for links in emails (and the SAML callback redirect). Unset: the first CORS_ORIGINS entry.
# FRONTEND_URL=https://euroid.example.com

# Secrets (REQUIRED: connector credentials are encrypted at rest; Temporal payloads are encrypted with a
# key derived from the same settings: infrastructure/secrets/docs/ARCHITECTURE.md § Temporal Payloads)
# Option A: Base64-encoded 32-byte key (recommended for production)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Key rotation: src/scripts/rotate-encryption-key.ts --generate prints a new key and key id and the steps
# (infrastructure/secrets/docs/ARCHITECTURE.md § Key Rotation).
# Id stored with every secret this key encrypts (default: default). Required while ENCRYPTION_KEY_PREVIOUS
# is set (the new key's id, not "default"); keep it after the rotation.
# ENCRYPTION_KEY_ID=key-2026-11-23-1a2b3c
# During a rotation only: the key the stored secrets were encrypted with, and the ENCRYPTION_KEY_ID it had
# (leave ENCRYPTION_KEY_PREVIOUS_ID unset if it had none). Remove both when the script reports it is done
# and no Temporal workflow started before the rotation is still running.
# ENCRYPTION_KEY_PREVIOUS=
# ENCRYPTION_KEY_PREVIOUS_ID=

# Option B: Passphrase (for local dev — key derived via PBKDF2). ENCRYPTION_KEY_SALT required.
# ENCRYPTION_KEY_PASSPHRASE=your-dev-passphrase
# ENCRYPTION_KEY_SALT=<base64-16-bytes>  # Generate: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"

# Option C: KMS (optional — when set, encryption keys from KMS instead of env)
# KMS_PROVIDER=aws
# AWS_KMS_KEY_ARN=arn:aws:kms:eu-west-1:123456789:key/abc-def
# AWS_REGION=eu-west-1
# AWS_KMS_WRAPPED_DEK=<base64-from-bootstrap-or-rotation>

# KMS_PROVIDER=azure
# AZURE_KEYVAULT_URL=https://euroid-vault.vault.azure.net
# AZURE_KEYVAULT_KEY_NAME=euroid-encryption-key
# AZURE_KEYVAULT_WRAPPED_DEK=<base64-from-bootstrap-or-rotation>

# Temporal mTLS (optional: when all three are set and the files exist, the worker and the API's
# Temporal client use client certs)
# TEMPORAL_TLS_CERT_PATH=/certs/temporal-client.pem
# TEMPORAL_TLS_KEY_PATH=/certs/temporal-client-key.pem
# TEMPORAL_TLS_CA_PATH=/certs/temporal-ca.pem

# CSP (optional — Content Security Policy)
# CSP_REPORT_ONLY=true
# CSP_REPORT_URI=https://your-csp-report-endpoint.com/csp

# Metrics (optional — when set, /metrics requires Authorization: Bearer <METRICS_TOKEN>)
# METRICS_TOKEN=

# Logging — PII redaction (Batch 13). Set LOG_PII_REDACT=false to disable in local dev only.
# LOG_PII_REDACT=true

# Reconciliation parallelism (scatter-gather)
RECONCILIATION_BATCH_COUNT=10
RECONCILIATION_BATCH_SIZE=5000
# Identities per hub page a reconciliation batch fetches (one activity result; default 200, at most 5000)
# RECONCILIATION_PAGE_SIZE=200

# Access reviews: review items per revocation batch when a campaign closes (default 50)
# ACCESS_REVIEW_REVOCATION_BATCH_SIZE=50

# Data Retention (TTL indexes and soft-delete purge)
WORKFLOW_RETENTION_DAYS=90
USER_EVENTS_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=365
IDENTITY_SOFT_DELETE_RETENTION_DAYS=30
# Hours an encrypted rollback snapshot (pre-change state for bulk provisioning and distributed
# transaction rollbacks, collection rollback_snapshots) is kept. Keep it longer than the longest
# bulk run (6 hours): a rollback after expiry reports the change as not rolled back.
ROLLBACK_SNAPSHOT_TTL_HOURS=24

# Cold Storage Archival (S3 or Azure Blob — export before TTL delete)
# ARCHIVAL_ENABLED=false            # true: worker schedules archivalWorkflow (exports audit_events and
#                                   # user_events older than AUDIT_/USER_EVENTS_RETENTION_DAYS per tenant,
#                                   # then deletes them). Requires ARCHIVAL_STORAGE_PROVIDER.
# ARCHIVAL_CRON=0 2 * * *           # Schedule (default 02:00 daily)
# ARCHIVAL_STORAGE_PROVIDER=s3
# ARCHIVAL_STORAGE_BUCKET=euroid-archive
# ARCHIVAL_STORAGE_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# For Azure Blob:
# ARCHIVAL_STORAGE_PROVIDER=azure-blob
# ARCHIVAL_STORAGE_CONTAINER=euroid-archive
# AZURE_STORAGE_CONNECTION_STRING=

# Audit hash chain and Merkle checkpoints
# AUDIT_CHAIN_WRITE_ATTEMPTS=50     # tries per audit write while other writers take the next chain
#                                   # position first (then the write fails)
# AUDIT_CHECKPOINT_MAX_EVENTS=10000 # audit events per Merkle checkpoint (POST /audit/merkle-roots and
#                                   # the daily audit archive run)
# AUDIT_CHECKPOINT_MAX_PER_RUN=50   # checkpoints the daily audit archive run makes per tenant; it runs
#                                   # only with AUDIT_ARCHIVE_ENABLED=true

# Audit archive (modules/audit): each day the worker's auditArchiveWorkflow makes the tenants' Merkle
# checkpoints and exports the settled ones (older than 24 hours) to S3 with Object Lock, so they
# cannot be changed or deleted. Separate from ARCHIVAL_* above: it deletes nothing.
# AUDIT_ARCHIVE_ENABLED=false       # true: the worker creates the Temporal schedule audit-archive-daily.
#                                   # With true and no AUDIT_ARCHIVE_S3_BUCKET the API and the worker
#                                   # refuse to start (both build the archive's storage at start).
# AUDIT_ARCHIVE_CRON=0 3 * * *      # When it runs (default 03:00 daily, UTC). Read when the worker
#                                   # creates the schedule; an existing schedule keeps its cron.
# AUDIT_ARCHIVE_S3_BUCKET=          # Required with AUDIT_ARCHIVE_ENABLED=true: a bucket created with
#                                   # S3 Object Lock enabled (each object is locked in COMPLIANCE mode)
# AUDIT_ARCHIVE_S3_REGION=          # The bucket's region; default ARCHIVAL_STORAGE_REGION, else us-east-1
# AUDIT_ARCHIVE_S3_PREFIX=euroid    # Object keys: <prefix>/<tenantId>/audit-archive/<yyyy>/<mm>/<root>.json.gz
# AUDIT_WORM_RETENTION_DAYS=2555    # Object Lock retention per object in days (default about 7 years);
#                                   # in COMPLIANCE mode no one can delete the object or shorten its
#                                   # lock until then
# AUDIT_ARCHIVE_INCLUDE_PAYLOAD=false # true: each exported event also carries its actor, resource name,
#                                   # description, payload, source and target system, which can be
#                                   # personal data that cannot be erased before the retention ends.
#                                   # Default: hashes and metadata only.
# The S3 credentials are AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY above when both are set, else the
# AWS SDK's default chain (instance role, shared config).

# Merkle checkpoint anchor (modules/audit). Unset: checkpoints are not signed (the Audit integrity
# page shows "Not signed") and nothing goes to a witness.
# Ed25519 private key (PEM, PKCS#8) that signs each checkpoint as it is made (its root, event
# count, time span and the previous root), so a verifier holding only the public key can tell a
# checkpoint this deployment made from one rebuilt in the database. Keep it out of the audit
# database, out of git and out of backups of either. Make a key pair:
#   openssl genpkey -algorithm ed25519 -out audit-anchor.pem
#   openssl pkey -in audit-anchor.pem -pubout -out audit-anchor.pub.pem
# and paste each file's content in double quotes (dotenv keeps the newlines, or write them as \n).
# A key that does not load leaves signing off (logged at start). With a new key, checkpoints signed
# with the old one no longer verify on the page: keep the old public key to check them elsewhere.
# AUDIT_ANCHOR_PRIVATE_KEY=
# The public half of that key (PEM, SPKI). Its fingerprint is stored with each signature, and the
# anchor proof (GET /api/v1/audit/merkle-roots/:checkpointId/anchor) checks signatures with it.
# Unset: derived from the private key. Read only when AUDIT_ANCHOR_PRIVATE_KEY is set.
# AUDIT_ANCHOR_PUBLIC_KEY=
# External witness: each signed checkpoint's envelope is POSTed to this URL as JSON, best effort
# (the answer's HTTP status and X-Witness-Id header are stored with the checkpoint; a failure is
# logged). Unset: no witness.
# AUDIT_ANCHOR_WITNESS_URL=
# How long a delivery to that witness waits for its answer, in milliseconds; one not answered by
# then is logged as failed and the checkpoint is kept without the witness's answer. Default 10000.
# AUDIT_ANCHOR_WITNESS_TIMEOUT_MS=10000

# Non-human identity credentials (modules/nhi). Unset: the API issues no credentials (409) and
# publishes no public key; the NHI page disables issuing.
# Ed25519 private key (PEM, PKCS#8) that signs agent credentials; GET /api/v1/nhi/_/public-key
# publishes its public half. Make one: openssl genpkey -algorithm ed25519 -out nhi-signing.pem
# and paste the file's content in double quotes (dotenv keeps the newlines, or write them as \n).
# A new key invalidates every credential issued with the old one. Keep it out of git.
# NHI_SIGNING_PRIVATE_KEY=
# SPIFFE trust domain in the credentials' ids: spiffe://<domain>/tenants/<tenant>/agents/<agent>
# (default euroid.local)
# NHI_TRUST_DOMAIN=euroid.local

# Auth (set AUTH_DISABLED=true for local dev without an IdP)
AUTH_DISABLED=true
# Platform admins: who may manage tenants (/tenants) and read deployment diagnostics.
# Comma-separated authenticated user ids (JWT sub: the AdminUser _id for local login, the IdP
# subject for OIDC), never emails. Unset = nobody. A tenant's super-admin is not a platform admin.
# Add emergency-admin for break-glass, dev-user for AUTH_DISABLED dev mode.
# PLATFORM_ADMIN_USER_IDS=
# Break-glass emergency access (when OIDC is down). Disabled when unset.
# EMERGENCY_ADMIN_TOKEN=<hex-token-from-crypto-randomBytes-48>
# EMERGENCY_TOKEN_VALID_UNTIL=2026-02-18T12:00:00.000Z
# Local auth: JWT signing secret (REQUIRED in production; required when using email/password login)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-random-string-in-production
OIDC_ISSUER=https://login.microsoftonline.com/YOUR_TENANT/v2.0
OIDC_AUDIENCE=your-euroid-client-id

# Multi-tenancy
MULTI_TENANCY_ENABLED=true
DEFAULT_TENANT_ID=dev-tenant
DEV_TENANT_ID=dev-tenant
JWT_TENANT_CLAIM=tenantId

# Public host for SCIM URLs when headers are missing (e.g. production).
# API_PUBLIC_HOST=api.example.com

# OpenTelemetry Tracing (see docs/architecture/infrastructure/OBSERVABILITY_ARCHITECTURE.md)
# Set OTEL_SDK_DISABLED=true to disable tracing (e.g. when no collector is available)
OTEL_SDK_DISABLED=false
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=euroid-backend

# SAML 2.0 SSO (optional — leave unset to disable)
# SAML_ENTRY_POINT=https://idp.example.com/sso/saml
# SAML_ISSUER=euroid-sp
# SAML_CALLBACK_URL=https://your-euroid-domain.com/api/v1/auth/saml/callback
# SAML_CERT=<base64-encoded IdP signing certificate, single line>
# SAML_WANT_ASSERTIONS_SIGNED=true
# SAML_ACCEPTED_CLOCK_SKEW_MS=30000
# SAML_SIGNATURE_ALGORITHM=sha256
# SAML_EMAIL_ATTR=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress
# SAML_NAME_ATTR=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name
# SAML_ROLE_ATTR=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/role
# SAML_TENANT_ATTR=tenantId
# SAML_AUTO_CREATE_USER=true
# SAML_DEFAULT_ROLE=viewer
# The strongest role a SAML admin created on a first sign-in gets (asserted or default role held
# to it). Default viewer; super-admin is refused. Existing admins keep their stored role.
# SAML_JIT_MAX_ROLE=viewer
# Tenants SAML_TENANT_ATTR may name (comma-separated); each must exist in tenants and be active.
# Unset: only SAML_DEFAULT_TENANT_ID (else DEFAULT_TENANT_ID).
# SAML_ALLOWED_TENANT_IDS=tenant-a,tenant-b

# --- TASK_101: EMERGENCY_ADMIN_TOKEN, EMERGENCY_TOKEN_VALID_UNTIL. TASK_102: ENCRYPTION_KEY_ID, ENCRYPTION_KEY_PREVIOUS, ENCRYPTION_KEY_PREVIOUS_ID.
# --- Task 108 recap: ARCHIVAL_STORAGE_* vars for cold storage (S3/Azure Blob) before TTL delete.
# --- Task 116 recap: SAML_* vars for SAML 2.0 SSO.
# --- Task 120 recap: KMS_PROVIDER (aws/azure), Temporal mTLS, CSP_REPORT_ONLY, CSP_REPORT_URI, SCIM HTTPS in production.
