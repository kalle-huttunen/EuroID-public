# EuroID Backend Worker — multi-stage production build
FROM node:20-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install

FROM node:20-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build && node scripts/build-workflow-bundle.js

FROM node:20-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json tsconfig.json ./
RUN npm install --omit=dev
COPY --from=builder /app/dist ./dist
# No HEALTHCHECK — Temporal handles worker liveness via heartbeats
CMD ["node", "-r", "tsconfig-paths/register", "dist/src/worker.js"]
